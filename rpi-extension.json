{
  "schemaVersion": 1,
  "name": "rpi-hello",
  "version": "0.1.0",
  "type": "extension",
  "description": "Minimal rpi extension: a hello tool and a /hello command",
  "license": "MIT",
  "targets": [
    { "target": "x86_64-unknown-linux-gnu" },
    { "target": "aarch64-unknown-linux-gnu" },
